# Required at server startup.
MONGO_URI=
# Provide a random secret of at least 32 characters.
JWT_SECRET=
# Optional; server defaults this to 1d.
JWT_EXPIRES_IN=1d
# Required: exact frontend origin(s), comma-separated when there is more than one.
CLIENT_URL=

# Optional: Render supplies PORT; local fallback is 5000.
PORT=
# Set to production to avoid development stack traces in server logs.
NODE_ENV=production
# Optional. Leave empty locally; set to 1 on Render when running behind its proxy.
TRUST_PROXY=

# Optional admission email delivery. Applications still save when email is unavailable.
RESEND_API_KEY=
ADMISSIONS_NOTIFICATION_EMAIL=
ADMISSIONS_FROM_EMAIL=
# Legacy recipient/sender aliases are supported if the primary names above are unset.
ADMISSIONS_ADMIN_EMAIL=
RESEND_FROM_EMAIL=

# Required for public admission submissions; set only confirmed session names.
# Separate multiple sessions with commas. Empty means online admissions are unavailable.
ADMISSION_ACADEMIC_SESSIONS=

# Optional at startup; required for gallery and poster image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only for the one-time `npm run seed:admin` command; never needed to run the server.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
